# PrivacyGuard AI Frontend Configuration Template
# Copy this file to .env or .env.local and populate with your project credentials.
# The actual .env file is git-ignored and must never be committed.

# 1. FastAPI AI Detection Backend (GLiNER + Presidio inference engine)
# In production on Vercel: Set VITE_API_BASE_URL to your public backend URL (e.g. https://your-backend.onrender.com or https://username-space.hf.space)
# In local development: Defaults to http://localhost:8000 when not set
VITE_API_BASE_URL=http://localhost:8000

# 2. Supabase Cloud Configuration
# Find these in your Supabase Dashboard:
# Project Settings -> API -> Project URL & Project API Keys
#
# IMPORTANT SECURITY RULES:
# - ONLY use the Project URL and Publishable / Anon API key here.
# - NEVER put your secret "service_role" key in any frontend code or .env!
# - Zero raw documents or detected PII are stored in Supabase.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here
