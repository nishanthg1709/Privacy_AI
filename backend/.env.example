# PrivacyGuard AI Backend Configuration
# Copy this file to .env: `cp .env.example .env`

# Network and Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Allowed CORS origins (restricted for security)
CORS_ORIGINS=http://localhost:5173

# Local AI PII Detection Model Configuration
# Model: urchade/gliner_small-v2.1 is lightweight (~160MB), fast, and local Apache-2.0
# Set ENABLE_GLINER=false in 512MB RAM instances (e.g. Render free tier) to run in honest
# degraded mode (Presidio + deterministic secrets) without crashing the instance.
ENABLE_GLINER=true
AI_MODEL_NAME=urchade/gliner_small-v2.1
AI_DEVICE=cpu
AI_CONFIDENCE_THRESHOLD=0.45
AI_FALLBACK_ON_ERROR=true

# Presidio Complementary Engine
ENABLE_PRESIDIO=true

# Request Security Limits
MAX_PAYLOAD_CHARS=100000
REQUEST_TIMEOUT_SECONDS=30
